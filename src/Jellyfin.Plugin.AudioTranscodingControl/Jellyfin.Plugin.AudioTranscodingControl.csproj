<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.AudioTranscodingControl</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Configuration/configPage.html" />
    <Reference Include="Jellyfin.Api" HintPath="$(JellyfinServerDir)/Jellyfin.Api.dll" Private="false" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Jellyfin.Plugin.AudioTranscodingControl.Tests</_Parameter1>
    </AssemblyAttribute>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="[10.11.11]" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="[10.11.11]" ExcludeAssets="runtime" />
  </ItemGroup>
  <Target Name="RequireJellyfinApi" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(JellyfinServerDir)/Jellyfin.Api.dll')" Text="Run scripts/prepare-test-server.ps1 to obtain the pinned Jellyfin 10.11.11 API assembly. No server installation is performed." />
  </Target>
</Project>
